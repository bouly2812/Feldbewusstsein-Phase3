REM STRANG 3 - FELDBEWUSSTSEIN KOPPLUNGS- UND ZUSTANDSUEBERGANGSLOGIK (CPBASIC)
DIM RHO AS SINGLE
DIM PSI AS SINGLE
DIM EXTERN_SIG AS SINGLE
DIM C_KOPPLUNG AS SINGLE
DIM SCHWELLE AS SINGLE
DIM PERSISTENZ AS INTEGER
DIM ZAEHLER_KIPP AS INTEGER
DIM ZUSTAND_Z AS INTEGER
DIM SCHRITT_IDX AS INTEGER
DIM ARTEFAKT AS INTEGER

SCHWELLE = 0.72
PERSISTENZ = 5
ZAEHLER_KIPP = 0
ZUSTAND_Z = 0
SCHRITT_IDX = 0
ARTEFAKT = 0

SUB PRUEFE_FELDBEWUSSTSEIN(RHO, PSI, EXTERN_SIG)
    SCHRITT_IDX = SCHRITT_IDX + 1
    ARTEFAKT = 0

    IF RHO < 0.0 THEN RHO = 0.0
    IF RHO > 1.0 THEN RHO = 1.0
    IF PSI < 0.0 THEN PSI = 0.0
    IF PSI > 1.0 THEN PSI = 1.0

    IF ABS(EXTERN_SIG) > 0.85 AND PSI < 0.35 THEN
        ARTEFAKT = 1
    END IF

    C_KOPPLUNG = (0.4 * RHO) + (0.4 * PSI) + (0.2 * RHO * PSI)
    IF C_KOPPLUNG > 1.0 THEN C_KOPPLUNG = 1.0
    IF C_KOPPLUNG < 0.0 THEN C_KOPPLUNG = 0.0

    IF ARTEFAKT = 0 AND C_KOPPLUNG >= SCHWELLE THEN
        ZAEHLER_KIPP = ZAEHLER_KIPP + 1
    ELSE
        ZAEHLER_KIPP = 0
    END IF

    IF ZAEHLER_KIPP >= PERSISTENZ THEN
        ZUSTAND_Z = ZUSTAND_Z + 1
        PRINT "SCHRITT=", SCHRITT_IDX, " | FELDBEWUSSTSEIN UEBERGANG Z=", ZUSTAND_Z, " | c=", C_KOPPLUNG
        ZAEHLER_KIPP = 0
    ELSE
        PRINT "SCHRITT=", SCHRITT_IDX, " | Z=", ZUSTAND_Z, " | c=", C_KOPPLUNG, " | ART=", ARTEFAKT, " | KIPP=", ZAEHLER_KIPP
    END IF
END SUB